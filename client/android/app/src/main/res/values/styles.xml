<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — 状态栏使用App背景色，防止内容穿透 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#0a0f16</item>
        <item name="colorPrimaryDark">#0a0f16</item>
        <item name="colorAccent">#c4922e</item>
        <item name="android:statusBarColor">#0a0f16</item>
        <item name="android:navigationBarColor">#0a0f16</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 主Activity主题 — 禁用半透明状态栏，内容自动避开状态栏 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#0a0f16</item>
        <item name="android:navigationBarColor">#0a0f16</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!-- 启动屏主题 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#0a0f16</item>
    </style>
</resources>
